	url = https://github.com/ProtonLumo/lumo-desktop
	install = lumo-desktop.install
	arch = x86_64
	arch = aarch64
	license = GPL-3.0-only
	makedepends = git
	makedepends = nodejs
	makedepends = npm
	makedepends = rust
	makedepends = pkgconf
	makedepends = cmake
	makedepends = perl
	depends = gtk3
	depends = webkit2gtk-4.1
	depends = libayatana-appindicator
	depends = libsoup3
	depends = glib2
	depends = dbus
	depends = ca-certificates
	depends = hicolor-icon-theme
